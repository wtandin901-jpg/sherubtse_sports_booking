{
  "info": {
    "name": "Sherubtse Sports Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Booking day = 3 days from now in Bhutan time (UTC+6)",
          "const day = new Date(Date.now() + (3*24*60 + 360)*60000).toISOString().slice(0,10);",
          "pm.collectionVariables.set('day', day);",
          "// Every non-GET request needs a fresh CSRF token (it changes after login)",
          "if (pm.request.method !== 'GET') {",
          "  pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/api/auth/csrf', method: 'GET' }, (err, res) => {",
          "    if (!err) pm.collectionVariables.set('csrfToken', res.json().data.csrfToken);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.edu.bt"
    },
    {
      "key": "adminPassword",
      "value": "CHANGE-ME-12345"
    },
    {
      "key": "crrlEmail",
      "value": "crrl@example.edu.bt"
    },
    {
      "key": "crrlPassword",
      "value": "CHANGE-ME-12345"
    },
    {
      "key": "studentEmail",
