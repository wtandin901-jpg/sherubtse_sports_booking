<%- include('partials/header') %>
<section class="panel narrow">
  <h1>Change password</h1>
  <% if (user.must_change_password) { %><p class="flash warn">You must choose a new password before continuing.</p><% } %>
  <form data-api data-url="/api/auth/change-password" data-method="POST" data-redirect="/dashboard">
    <label>Current password <input type="password" name="currentPassword" required autocomplete="current-password"></label>
    <label>New password (12+ characters, letters and digits)
      <input type="password" name="newPassword" required minlength="12" maxlength="72" autocomplete="new-password"></label>
    <button class="btn" type="submit">Change password</button>
  </form>
</section>
<%- include('partials/footer') %>
