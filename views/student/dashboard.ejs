<%- include('../partials/header') %>
<h1>Available grounds</h1>
<p class="muted">View-only. To book a slot, ask your CR/RL.</p>

<section class="panel">
  <h2>Open schedules</h2>
  <% if (!schedules.length) { %><p class="muted">No open schedules yet.</p><% } %>
  <% schedules.forEach(s => { %>
    <article class="schedule">
      <h3><%= s.ground_name %> &middot; <%= fmt(s.start_time) %> &ndash; <%= fmt(s.end_time) %></h3>
      <div class="slots">
        <% s.slots.forEach(slot => { %>
          <span class="slot <%= slot.available ? 'free' : 'taken' %>"><%= fmt(slot.start) %> <small><%= slot.available ? 'Available' : 'Booked' %></small></span>
        <% }) %>
      </div>
    </article>
  <% }) %>
</section>

<section class="panel">
  <h2>Upcoming booked sessions</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Ground</th><th>Start</th><th>End</th><th>Status</th></tr></thead>
    <tbody>
    <% booked.forEach(b => { %>
      <tr><td><%= b.ground_name %></td><td><%= fmt(b.start_time) %></td><td><%= fmt(b.end_time) %></td><td><%= b.status === 'pending' ? 'Pending approval' : 'Booked' %></td></tr>
    <% }) %>
    <% if (!booked.length) { %><tr><td colspan="4" class="muted">Nothing booked yet.</td></tr><% } %>
    </tbody></table></div>
</section>
<%- include('../partials/footer') %>
