{
  "name": "sherubtse-sports-booking",
  "version": "1.0.0",
  "description": "Sherubtse College Sports Ground Booking Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:setup:test": "cross-env NODE_ENV=test node scripts/setup-db.js",
    "admin:create": "node scripts/create-admin.js",
    "users:import": "node scripts/import-users.js",
